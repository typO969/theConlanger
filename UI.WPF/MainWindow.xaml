<Window x:Class="UI.WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:UI.WPF.ViewModels"
 Title="Conlang Builder" Height="680" Width="1140">
	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>
	<DockPanel>
		<StackPanel DockPanel.Dock="Top" Margin="10">
			<TextBlock FontSize="20" FontWeight="Bold" Text="Conlang Builder"/>
			<TextBlock Text="{Binding CurrentProjectPath}" FontSize="11" Foreground="Gray" Margin="0,2,0,8"/>
			<WrapPanel>
				<Button Content="Save" Command="{Binding SaveProjectCommand}" Margin="0,0,6,6" Width="80"/>
				<Button Content="Save As" Command="{Binding SaveProjectAsCommand}" Margin="0,0,6,6" Width="80"/>
				<Button Content="Load" Command="{Binding LoadProjectCommand}" Margin="0,0,6,6" Width="80"/>
				<Button Content="Undo" Command="{Binding UndoCommand}" Margin="0,0,6,6" Width="80"/>
				<Button Content="Redo" Command="{Binding RedoCommand}" Margin="0,0,6,6" Width="80"/>
				<Button Content="Import Lexicon" Command="{Binding ImportLexiconCommand}" Margin="0,0,6,6" Width="110"/>
				<Button Content="Export Lexicon" Command="{Binding ExportLexiconCommand}" Margin="0,0,6,6" Width="110"/>
			</WrapPanel>
			<ItemsControl ItemsSource="{Binding RecentFiles}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<Button Content="{Binding}" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Left" Margin="0,0,0,4"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</StackPanel>
		<TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
			<TabControl.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Title}"/>
				</DataTemplate>
			</TabControl.ItemTemplate>
			<TabControl.ContentTemplate>
				<DataTemplate>
					<ContentPresenter Content="{Binding ContentView}"/>
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>
	</DockPanel>
</Window>
