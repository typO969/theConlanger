<Window x:Class="UI.WPF.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:UI.WPF.ViewModels"
 Title="Conlang Builder" Height="600" Width="1000">
	<Window.DataContext>
		<vm:MainViewModel/>
	</Window.DataContext>
	<DockPanel>
		<TextBlock DockPanel.Dock="Top" FontSize="20" FontWeight="Bold" Text="Conlang Builder" Margin="10"/>
		<TabControl ItemsSource="{Binding Tabs}" SelectedItem="{Binding SelectedTab}">
			<TabControl.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding Title}"/>
				</DataTemplate>
			</TabControl.ItemTemplate>
			<TabControl.ContentTemplate>
				<DataTemplate>
					<ContentPresenter Content="{Binding ContentView}"/>
				</DataTemplate>
			</TabControl.ContentTemplate>
		</TabControl>
	</DockPanel>
</Window>