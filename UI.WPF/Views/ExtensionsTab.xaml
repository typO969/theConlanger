<UserControl x:Class="UI.WPF.Views.ExtensionsTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
   <TextBlock Text="Phase 4 Readiness: Plugin Discovery" FontSize="16" FontWeight="Bold" Margin="0,0,12,0"/>
   <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="90"/>
  </StackPanel>

  <DataGrid Grid.Row="1" ItemsSource="{Binding Plugins}" AutoGenerateColumns="False" CanUserAddRows="False">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
    <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="280"/>
   </DataGrid.Columns>
  </DataGrid>

  <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
 </Grid>
</UserControl>
