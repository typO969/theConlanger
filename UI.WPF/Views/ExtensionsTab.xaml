<UserControl x:Class="UI.WPF.Views.ExtensionsTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:UI.WPF.Views">
 <UserControl.Resources>
  <DataTemplate x:Key="ArgumentTextTemplate">
   <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
  </DataTemplate>
  <DataTemplate x:Key="ArgumentBoolTemplate">
   <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center" />
  </DataTemplate>
  <DataTemplate x:Key="ArgumentOptionsTemplate">
   <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
  </DataTemplate>
  <local:PluginArgumentTemplateSelector x:Key="ArgumentTemplateSelector"
   TextTemplate="{StaticResource ArgumentTextTemplate}"
   BoolTemplate="{StaticResource ArgumentBoolTemplate}"
   OptionsTemplate="{StaticResource ArgumentOptionsTemplate}" />
 </UserControl.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="2*"/>
   <RowDefinition Height="2*"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
  </Grid.RowDefinitions>

  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
   <TextBlock Text="Phase 4 Readiness: Plugin Discovery" FontSize="16" FontWeight="Bold" Margin="0,0,12,0"/>
   <Button Content="Refresh" Command="{Binding RefreshCommand}" Width="90"/>
  </StackPanel>

  <DataGrid Grid.Row="1" ItemsSource="{Binding Plugins}" AutoGenerateColumns="False" CanUserAddRows="False" SelectedItem="{Binding SelectedPlugin}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="200"/>
    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="120"/>
    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
   </DataGrid.Columns>
  </DataGrid>

  <DataGrid Grid.Row="2" ItemsSource="{Binding Actions}" AutoGenerateColumns="False" CanUserAddRows="False" SelectedItem="{Binding SelectedAction}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Plugin" Binding="{Binding PluginName}" Width="160"/>
    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="160"/>
    <DataGridTextColumn Header="Action" Binding="{Binding ActionLabel}" Width="*"/>
    <DataGridTextColumn Header="Last Result" Binding="{Binding LastResult}" Width="240"/>
    <DataGridTemplateColumn Header="Run" Width="90">
     <DataGridTemplateColumn.CellTemplate>
      <DataTemplate>
       <Button Content="Run" Command="{Binding RunCommand}" Width="70"/>
      </DataTemplate>
     </DataGridTemplateColumn.CellTemplate>
    </DataGridTemplateColumn>
   </DataGrid.Columns>
  </DataGrid>

  <Grid Grid.Row="3" Margin="0,8,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition Width="2*"/>
    <ColumnDefinition Width="3*"/>
   </Grid.ColumnDefinitions>

   <StackPanel Grid.Column="0">
    <TextBlock Text="Plugin Details" FontWeight="Bold" Margin="0,0,0,6"/>
    <TextBlock Text="{Binding SelectedPlugin.Name}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedPlugin.Version}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedPlugin.IsolationMode}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedPlugin.Author}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedPlugin.Description}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedPlugin.CapabilitiesDisplay}" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding SelectedPlugin.Website}" TextWrapping="Wrap"/>
   </StackPanel>

   <StackPanel Grid.Column="1">
    <TextBlock Text="Action Arguments" FontWeight="Bold" Margin="0,0,0,6"/>
    <DataGrid ItemsSource="{Binding SelectedAction.Arguments}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
     <DataGrid.Columns>
      <DataGridTextColumn Header="Name" Binding="{Binding Label}" Width="160" IsReadOnly="True"/>
      <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120" IsReadOnly="True"/>
      <DataGridTemplateColumn Header="Value" Width="*">
       <DataGridTemplateColumn.CellTemplate>
        <DataTemplate>
         <ContentControl Content="{Binding}" ContentTemplateSelector="{StaticResource ArgumentTemplateSelector}" />
        </DataTemplate>
       </DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTextColumn Header="Required" Binding="{Binding Required}" Width="80" IsReadOnly="True"/>
      <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="220" IsReadOnly="True"/>
     </DataGrid.Columns>
    </DataGrid>
   </StackPanel>
  </Grid>

  <TextBlock Grid.Row="4" Text="{Binding Status}" Margin="0,8,0,0" TextWrapping="Wrap"/>
  <TextBox Grid.Row="5" Text="{Binding LogText}" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="120"/>
 </Grid>
</UserControl>
