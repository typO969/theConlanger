<UserControl x:Class="UI.WPF.Views.OutputTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <StackPanel Margin="20">
  <Button Content="Generate Sentence" Width="200" Margin="0,0,0,10"
          Command="{Binding GenerateCommand}"/>
  <TextBox Text="{Binding OutputText}" FontFamily="Consolas" FontSize="16"
           Height="300" AcceptsReturn="True" TextWrapping="Wrap"/>
 </StackPanel>
</UserControl>