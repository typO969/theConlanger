<UserControl x:Class="UI.WPF.Views.PhonologyTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="180"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="140"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Consonants" FontWeight="Bold"/>
        <ListBox ItemsSource="{Binding Consonants}" Height="120">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock Text="{Binding}" Margin="0,0,8,0"/>
                <Button Content="Remove" DockPanel.Dock="Right" Command="{Binding DataContext.RemovePhonemeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Vowels" FontWeight="Bold"/>
        <ListBox ItemsSource="{Binding Vowels}" Height="120">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel>
                <TextBlock Text="{Binding}" Margin="0,0,8,0"/>
                <Button Content="Remove" DockPanel.Dock="Right" Command="{Binding DataContext.RemovePhonemeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
      <TextBox Width="100" Text="{Binding NewPhoneme}" Margin="0,0,6,0"/>
      <Button Content="Add C" Command="{Binding AddConsonantCommand}" Margin="0,0,6,0"/>
      <Button Content="Add V" Command="{Binding AddVowelCommand}"/>
    </StackPanel>

    <TextBlock Grid.Row="2" Text="Phonological Rules" FontWeight="Bold" Margin="0,0,0,6"/>
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <ListBox ItemsSource="{Binding Rules}" Margin="0,0,10,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
              <Button Content="Remove" DockPanel.Dock="Right" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Column="1">
        <TextBox Text="{Binding NewRuleName}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding NewRuleTarget}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding NewRuleReplacement}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding NewRulePrev}" Margin="0,0,0,4"/>
        <TextBox Text="{Binding NewRuleNext}" Margin="0,0,0,6"/>
        <Button Content="Add Rule" Command="{Binding AddRuleCommand}"/>
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="4" Margin="0,8,0,0">
      <Button Content="Show Derivation" Width="130" Command="{Binding PreviewDerivationCommand}" Margin="0,0,0,6"/>
      <TextBox Text="{Binding DerivationPreview}" IsReadOnly="True" AcceptsReturn="True" Height="120"/>
    </StackPanel>
  </Grid>
</UserControl>
