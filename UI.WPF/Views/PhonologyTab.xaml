<UserControl x:Class="UI.WPF.Views.PhonologyTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Consonants -->
    <StackPanel Grid.Column="0">
      <TextBlock Text="Consonants" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
      <ListBox ItemsSource="{Binding Consonants}" Height="220">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock Text="{Binding}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Button Content="Remove" DockPanel.Dock="Right" Command="{Binding DataContext.RemovePhonemeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBox Width="100" Text="{Binding NewPhoneme, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>
        <Button Content="Add" Command="{Binding AddConsonantCommand}"/>
      </StackPanel>
    </StackPanel>

    <!-- Vowels -->
    <StackPanel Grid.Column="1">
      <TextBlock Text="Vowels" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
      <ListBox ItemsSource="{Binding Vowels}" Height="220">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel>
              <TextBlock Text="{Binding}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <Button Content="Remove" DockPanel.Dock="Right" Command="{Binding DataContext.RemovePhonemeCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <TextBox Width="100" Text="{Binding NewPhoneme, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,5,0"/>
        <Button Content="Add" Command="{Binding AddVowelCommand}"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>