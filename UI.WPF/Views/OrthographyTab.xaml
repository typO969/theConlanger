<UserControl x:Class="UI.WPF.Views.OrthographyTab"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="180"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="150"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Capitalization" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox Width="180" ItemsSource="{Binding CapitalizationModes}" SelectedItem="{Binding SelectedCapitalization}"/>
    </StackPanel>

    <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="80"/>
        <DataGridTextColumn Header="Grapheme" Binding="{Binding Grapheme}" Width="100"/>
        <DataGridTextColumn Header="Prev" Binding="{Binding PrevContext}" Width="80"/>
        <DataGridTextColumn Header="Next" Binding="{Binding NextContext}" Width="80"/>
        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="70"/>
        <DataGridTemplateColumn Header="">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Content="Remove" Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
      <TextBox Width="80" Text="{Binding NewPhone}" Margin="0,0,6,0"/>
      <TextBox Width="100" Text="{Binding NewGrapheme}" Margin="0,0,6,0"/>
      <TextBox Width="80" Text="{Binding NewPrevContext}" Margin="0,0,6,0"/>
      <TextBox Width="80" Text="{Binding NewNextContext}" Margin="0,0,6,0"/>
      <Button Content="Add Mapping" Command="{Binding AddRuleCommand}" Width="95"/>
    </StackPanel>

    <Grid Grid.Row="3">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Exceptions" FontWeight="Bold" Margin="0,0,0,6"/>
      <DataGrid Grid.Row="1" ItemsSource="{Binding Exceptions}" AutoGenerateColumns="False" CanUserAddRows="False">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Input" Binding="{Binding Input}" Width="*"/>
          <DataGridTextColumn Header="Output" Binding="{Binding Output}" Width="*"/>
          <DataGridTemplateColumn Header="">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Remove" Command="{Binding DataContext.RemoveExceptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,8">
      <TextBox Width="180" Text="{Binding NewExceptionInput}" Margin="0,0,6,0"/>
      <TextBox Width="180" Text="{Binding NewExceptionOutput}" Margin="0,0,6,0"/>
      <Button Content="Add Exception" Command="{Binding AddExceptionCommand}" Width="100"/>
    </StackPanel>

    <StackPanel Grid.Row="5">
      <TextBlock Text="Preview" FontWeight="Bold"/>
      <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
        <TextBox Width="250" Text="{Binding PreviewInput}" Margin="0,0,6,0"/>
        <Button Content="Render" Command="{Binding PreviewCommand}" Width="80"/>
      </StackPanel>
      <TextBox Text="{Binding PreviewOutput}" IsReadOnly="True"/>
    </StackPanel>
  </Grid>
</UserControl>
